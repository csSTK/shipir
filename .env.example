# Copy to .env (gitignored) and set your own values. Used by docker-compose.dev.yml and,
# when exported into the shell, by the Spring app (the app does not read .env itself).

# Required: database password. Never commit a real one.
DB_PASSWORD=change-me-local-dev-only

# Optional, defaults shown. Connection target for the app and the dev database.
DB_HOST=localhost
# Use 5433 if a native PostgreSQL already listens on 5432 (e.g. Postgres.app).
# The compose file publishes this host port on the container's 5432.
DB_PORT=5432
DB_NAME=shipir
DB_USER=shipir
