# Copy to .env (gitignored) and set your own values. Used by docker-compose.dev.yml,
# docker-compose.yml and, when exported into the shell, by the Spring app (the app does not read .env itself).

# Required: database password. Never commit a real one.
DB_PASSWORD=change-me-local-dev-only

# Required on first start (empty database): password of the initial 'admin' account. Startup fails
# without it; no default on purpose. Ignored once any user exists. The admin must change it on first login.
SHIPIR_INITIAL_ADMIN_PASSWORD=

# Optional, defaults shown. Connection target for the app and the dev database.
# Local development: DB_HOST=localhost is right. Hosting with docker-compose.yml: DB_HOST must point
# at the external PostgreSQL server (not localhost, which inside the backend container is the container itself).
DB_HOST=localhost
# Use 5433 if a native PostgreSQL already listens on 5432 (e.g. Postgres.app).
# docker-compose.dev.yml publishes this host port on the container's 5432.
DB_PORT=5432
DB_NAME=shipir
DB_USER=shipir

# Optional, hosting only (docker-compose.yml).
# Image tag to pull from ghcr.io (shipir-backend and shipir-frontend). Default: latest.
SHIPIR_TAG=latest
# Host port the frontend (and with it the whole app) is published on. Default: 8080.
SHIPIR_PORT=8080

# Hosting only (docker-compose.yml): Compose stack files are stored in the named volume shipir-stacks
# (mounted at /data/stacks). Nothing to set; the path is fixed in the backend image.

# Hosting only (docker-compose.yml): the backend mounts /var/run/docker.sock. Required, no default.
# Set it to the group ID that owns the socket on the host, e.g. `stat -c %g /var/run/docker.sock` (Linux).
# Anyone who can use the socket controls the host as root, so keep the stack and this file private.
DOCKER_GID=

# Hosting only (docker-compose.yml): key that encrypts stored TLS material at rest (AES-256-GCM).
# Optional while only the local Docker host exists; required for TCP+TLS hosts (the app fails to start
# without a valid key once such hosts exist). Generate with `openssl rand -base64 32` (must decode to
# 32 bytes). Keep it out of git and back it up: losing the key makes the stored TLS material unreadable.
SHIPIR_ENCRYPTION_KEY=

# Optional, local development: directory for Compose stack files (SHIPIR_STACKS_BASE_DIR). Default: ./data/stacks
# relative to the backend working directory. Hosting uses the fixed volume path above.
# SHIPIR_STACKS_BASE_DIR=./data/stacks

# Hosting only (docker-compose.yml): set to true when users reach Shipir over HTTPS (TLS terminated by a reverse
# proxy in front of the frontend port, see README). Turns on Secure session/XSRF cookies and HSTS.
SHIPIR_HTTPS=false

# Hosting only (docker-compose.yml): proxies whose X-Forwarded-For the backend believes, comma-separated IPs or
# CIDRs, for per-client login throttling. Default: the stack's own network (SHIPIR_SUBNET below), nothing to set.
# Add your own outer reverse proxy here (keep the default subnet in the list when you override).
# SHIPIR_SECURITY_TRUSTED_PROXIES=
# Subnet of the stack's dedicated network; change it only on a clash with an existing Docker network.
# SHIPIR_SUBNET=172.28.77.0/24

# Hosting only (docker-compose.yml): let OPERATORs with an OPERATE grant open container consoles (exec terminal).
# ADMIN can always open them. Default: false.
# SHIPIR_STREAMING_EXEC_OPERATOR_ENABLED=false

# Hosting only (docker-compose.yml): public origin of Shipir behind a reverse proxy, e.g. https://shipir.example.com.
# Used for the OIDC redirect URI. Empty by default: derived from the incoming request.
# SHIPIR_OIDC_PUBLIC_BASE_URL=
