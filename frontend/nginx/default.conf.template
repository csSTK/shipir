# Rendered by the nginx image's envsubst entrypoint. Only the container's environment variables
# (${BACKEND_URL}, ${NGINX_RESOLVER}, ${SHIPIR_HTTPS}) are substituted; nginx's own $variables stay untouched.
# Mirrors the dev proxy in vite.config.ts (/api and /ws -> backend).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# HSTS only when users reach Shipir over HTTPS (TLS at a reverse proxy in front); an empty value is not sent.
map "${SHIPIR_HTTPS}" $hsts_value {
    default "";
    "true"  "max-age=31536000; includeSubDomains";
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Re-resolve the backend hostname at request time so a restarted backend
    # container (new IP) is picked up. proxy_pass via a variable without a URI
    # forwards the original request URI unchanged.
    resolver ${NGINX_RESOLVER} valid=10s;
    set $backend "${BACKEND_URL}";

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location ~ ^/api(/|$) {
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }

    location ~ ^/ws(/|$) {
        proxy_pass $backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        # long-lived streams (logs, events, exec terminal)
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # Hashed build output: cache forever
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # SPA history fallback; index.html must always be revalidated
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
