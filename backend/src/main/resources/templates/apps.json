[
  {
    "id": "nginx",
    "name": "Nginx",
    "description": "Static web server. Serves the files in ./html on port 8080.",
    "logo": "nginx",
    "env": [],
    "spec": {
      "services": [
        {
          "name": "web",
          "image": "nginx:1.27-alpine",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 8080,
              "container": 80,
              "protocol": "tcp"
            }
          ],
          "volumes": [
            {
              "source": "./html",
              "target": "/usr/share/nginx/html",
              "readOnly": true
            }
          ]
        }
      ]
    }
  },
  {
    "id": "postgres",
    "name": "PostgreSQL",
    "description": "PostgreSQL 16 database with a named volume. Not published on the host; reach it from other containers on the same network.",
    "logo": "postgres",
    "env": [
      {
        "key": "POSTGRES_PASSWORD",
        "description": "Superuser password",
        "secret": true
      }
    ],
    "spec": {
      "services": [
        {
          "name": "db",
          "image": "postgres:16-alpine",
          "restart": "unless-stopped",
          "environment": [
            {
              "key": "POSTGRES_USER",
              "value": "postgres"
            },
            {
              "key": "POSTGRES_PASSWORD",
              "ref": "POSTGRES_PASSWORD"
            }
          ],
          "volumes": [
            {
              "source": "pgdata",
              "target": "/var/lib/postgresql/data",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "pgdata",
          "external": false
        }
      ]
    }
  },
  {
    "id": "redis",
    "name": "Redis",
    "description": "Redis 7 with append-only persistence. Not published on the host.",
    "logo": "redis",
    "env": [],
    "spec": {
      "services": [
        {
          "name": "cache",
          "image": "redis:7-alpine",
          "command": [
            "redis-server",
            "--appendonly",
            "yes"
          ],
          "restart": "unless-stopped",
          "volumes": [
            {
              "source": "redisdata",
              "target": "/data",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "redisdata",
          "external": false
        }
      ]
    }
  },
  {
    "id": "mariadb",
    "name": "MariaDB",
    "description": "MariaDB 11 database with a named volume and an initial database. Not published on the host.",
    "logo": "mariadb",
    "env": [
      {
        "key": "MARIADB_ROOT_PASSWORD",
        "description": "Root password",
        "secret": true
      }
    ],
    "spec": {
      "services": [
        {
          "name": "db",
          "image": "mariadb:11",
          "restart": "unless-stopped",
          "environment": [
            {
              "key": "MARIADB_ROOT_PASSWORD",
              "ref": "MARIADB_ROOT_PASSWORD"
            },
            {
              "key": "MARIADB_DATABASE",
              "value": "app"
            }
          ],
          "volumes": [
            {
              "source": "dbdata",
              "target": "/var/lib/mysql",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "dbdata",
          "external": false
        }
      ]
    }
  },
  {
    "id": "wordpress",
    "name": "WordPress",
    "description": "WordPress with its own MariaDB database. Open port 8081 after the first deploy to finish the setup.",
    "logo": "wordpress",
    "env": [
      {
        "key": "DB_ROOT_PASSWORD",
        "description": "MariaDB root password",
        "secret": true
      },
      {
        "key": "DB_PASSWORD",
        "description": "Password of the WordPress database user",
        "secret": true
      }
    ],
    "spec": {
      "services": [
        {
          "name": "web",
          "image": "wordpress:6-apache",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 8081,
              "container": 80,
              "protocol": "tcp"
            }
          ],
          "environment": [
            {
              "key": "WORDPRESS_DB_HOST",
              "value": "db"
            },
            {
              "key": "WORDPRESS_DB_NAME",
              "value": "wordpress"
            },
            {
              "key": "WORDPRESS_DB_USER",
              "value": "wordpress"
            },
            {
              "key": "WORDPRESS_DB_PASSWORD",
              "ref": "DB_PASSWORD"
            }
          ],
          "volumes": [
            {
              "source": "wpdata",
              "target": "/var/www/html",
              "readOnly": false
            }
          ],
          "dependsOn": [
            "db"
          ]
        },
        {
          "name": "db",
          "image": "mariadb:11",
          "restart": "unless-stopped",
          "environment": [
            {
              "key": "MARIADB_ROOT_PASSWORD",
              "ref": "DB_ROOT_PASSWORD"
            },
            {
              "key": "MARIADB_DATABASE",
              "value": "wordpress"
            },
            {
              "key": "MARIADB_USER",
              "value": "wordpress"
            },
            {
              "key": "MARIADB_PASSWORD",
              "ref": "DB_PASSWORD"
            }
          ],
          "volumes": [
            {
              "source": "dbdata",
              "target": "/var/lib/mysql",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "wpdata",
          "external": false
        },
        {
          "name": "dbdata",
          "external": false
        }
      ]
    }
  },
  {
    "id": "uptime-kuma",
    "name": "Uptime Kuma",
    "description": "Self-hosted uptime monitoring with a status page. Open port 3001 after the first deploy.",
    "logo": "uptime-kuma",
    "env": [],
    "spec": {
      "services": [
        {
          "name": "kuma",
          "image": "louislam/uptime-kuma:1",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 3001,
              "container": 3001,
              "protocol": "tcp"
            }
          ],
          "volumes": [
            {
              "source": "kuma-data",
              "target": "/app/data",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "kuma-data",
          "external": false
        }
      ]
    }
  },
  {
    "id": "adminer",
    "name": "Adminer",
    "description": "Lightweight web UI for SQL databases. Open port 8082 and connect to your database from there.",
    "logo": "adminer",
    "env": [],
    "spec": {
      "services": [
        {
          "name": "adminer",
          "image": "adminer:4",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 8082,
              "container": 8080,
              "protocol": "tcp"
            }
          ]
        }
      ]
    }
  },
  {
    "id": "vaultwarden",
    "name": "Vaultwarden",
    "description": "Lightweight Bitwarden-compatible password manager. Open port 8083 after the first deploy. Browsers need HTTPS for the web vault, so put it behind a domain.",
    "logo": "vaultwarden",
    "env": [
      {
        "key": "ADMIN_TOKEN",
        "description": "Token for the /admin page. Use an Argon2 PHC hash or a long random string.",
        "secret": true
      }
    ],
    "spec": {
      "services": [
        {
          "name": "vaultwarden",
          "image": "vaultwarden/server:1.32.5",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 8083,
              "container": 80,
              "protocol": "tcp"
            }
          ],
          "environment": [
            {
              "key": "ADMIN_TOKEN",
              "ref": "ADMIN_TOKEN"
            }
          ],
          "volumes": [
            {
              "source": "vw-data",
              "target": "/data",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "vw-data",
          "external": false
        }
      ]
    }
  },
  {
    "id": "gitea",
    "name": "Gitea",
    "description": "Self-hosted Git service with a web UI. Open port 3000 after the first deploy to finish the setup. SSH is not published.",
    "logo": "gitea",
    "env": [],
    "spec": {
      "services": [
        {
          "name": "gitea",
          "image": "gitea/gitea:1.22",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 3000,
              "container": 3000,
              "protocol": "tcp"
            }
          ],
          "volumes": [
            {
              "source": "gitea-data",
              "target": "/data",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "gitea-data",
          "external": false
        }
      ]
    }
  },
  {
    "id": "grafana",
    "name": "Grafana",
    "description": "Dashboards and alerting for metrics and logs. Open port 3100 after the first deploy and log in as admin with the password you set.",
    "logo": "grafana",
    "env": [
      {
        "key": "GF_SECURITY_ADMIN_PASSWORD",
        "description": "Password of the initial admin user",
        "secret": true
      }
    ],
    "spec": {
      "services": [
        {
          "name": "grafana",
          "image": "grafana/grafana:11.2.0",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 3100,
              "container": 3000,
              "protocol": "tcp"
            }
          ],
          "environment": [
            {
              "key": "GF_SECURITY_ADMIN_PASSWORD",
              "ref": "GF_SECURITY_ADMIN_PASSWORD"
            }
          ],
          "volumes": [
            {
              "source": "grafana-data",
              "target": "/var/lib/grafana",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "grafana-data",
          "external": false
        }
      ]
    }
  },
  {
    "id": "jellyfin",
    "name": "Jellyfin",
    "description": "Media server for movies, shows and music. Open port 8096 after the first deploy. No media folder is mounted; add a bind mount for your library in the wizard.",
    "logo": "jellyfin",
    "env": [],
    "spec": {
      "services": [
        {
          "name": "jellyfin",
          "image": "jellyfin/jellyfin:10.9.11",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 8096,
              "container": 8096,
              "protocol": "tcp"
            }
          ],
          "volumes": [
            {
              "source": "jellyfin-config",
              "target": "/config",
              "readOnly": false
            },
            {
              "source": "jellyfin-cache",
              "target": "/cache",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "jellyfin-config",
          "external": false
        },
        {
          "name": "jellyfin-cache",
          "external": false
        }
      ]
    }
  },
  {
    "id": "home-assistant",
    "name": "Home Assistant",
    "description": "Home automation hub. Open port 8123 after the first deploy. Runs on bridge networking, so device discovery that needs the host network does not work.",
    "logo": "home-assistant",
    "env": [],
    "spec": {
      "services": [
        {
          "name": "homeassistant",
          "image": "homeassistant/home-assistant:2024.9.3",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 8123,
              "container": 8123,
              "protocol": "tcp"
            }
          ],
          "volumes": [
            {
              "source": "ha-config",
              "target": "/config",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "ha-config",
          "external": false
        }
      ]
    }
  },
  {
    "id": "nextcloud",
    "name": "Nextcloud",
    "description": "Self-hosted file sync and sharing. Open port 8084 after the first deploy. Set the trusted domains to the names you open it with, or Nextcloud refuses them.",
    "logo": "nextcloud",
    "env": [
      {
        "key": "NEXTCLOUD_ADMIN_PASSWORD",
        "description": "Password of the initial admin user (username admin)",
        "secret": true
      },
      {
        "key": "NEXTCLOUD_TRUSTED_DOMAINS",
        "description": "Space-separated host names or IPs you open Nextcloud with, e.g. 192.168.1.10 cloud.example.com",
        "secret": false
      }
    ],
    "spec": {
      "services": [
        {
          "name": "nextcloud",
          "image": "nextcloud:29-apache",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 8084,
              "container": 80,
              "protocol": "tcp"
            }
          ],
          "environment": [
            {
              "key": "NEXTCLOUD_ADMIN_USER",
              "value": "admin"
            },
            {
              "key": "NEXTCLOUD_ADMIN_PASSWORD",
              "ref": "NEXTCLOUD_ADMIN_PASSWORD"
            },
            {
              "key": "NEXTCLOUD_TRUSTED_DOMAINS",
              "ref": "NEXTCLOUD_TRUSTED_DOMAINS"
            }
          ],
          "volumes": [
            {
              "source": "nextcloud-data",
              "target": "/var/www/html",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "nextcloud-data",
          "external": false
        }
      ]
    }
  }
]
