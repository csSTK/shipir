  {
    "id": "rabbitmq",
    "name": "RabbitMQ",
    "description": "Message broker with the management UI. Open port 15673 after the first deploy and sign in with the user and password below. Applications connect over AMQP on port 5673.",
    "logo": "rabbitmq",
    "env": [
      {
        "key": "RABBITMQ_DEFAULT_USER",
        "description": "Management and AMQP user",
        "secret": false,
        "defaultValue": "admin"
      },
      {
        "key": "RABBITMQ_DEFAULT_PASS",
        "description": "Management and AMQP password",
        "secret": true,
        "generate": true
      }
    ],
    "spec": {
      "services": [
        {
          "name": "rabbitmq",
          "image": "rabbitmq:3.13-management",
          "ports": [
            {
              "host": 5673,
              "container": 5672,
              "protocol": "tcp"
            },
            {
              "host": 15673,
              "container": 15672,
              "protocol": "tcp"
            }
          ],
          "environment": [
            {
