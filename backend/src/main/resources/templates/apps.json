  {
    "id": "syncthing",
    "name": "Syncthing",
    "description": "Continuous peer-to-peer file synchronization. Open port 8384 after the first deploy and set a GUI password under Actions, Settings. Sync traffic uses port 22000, local discovery 21027.",
    "logo": "syncthing",
    "env": [],
    "spec": {
      "services": [
        {
          "name": "syncthing",
          "image": "syncthing/syncthing:1.27.12",
          "ports": [
            {
              "host": 8384,
              "container": 8384,
              "protocol": "tcp"
            },
            {
              "host": 22000,
              "container": 22000,
              "protocol": "tcp"
            },
            {
              "host": 22000,
              "container": 22000,
              "protocol": "udp"
            },
            {
              "host": 21027,
              "container": 21027,
              "protocol": "udp"
            }
          ],
          "volumes": [
            {
              "source": "syncthing-data",
              "target": "/var/syncthing",
