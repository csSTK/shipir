  {
    "id": "nextcloud",
    "name": "Nextcloud",
    "description": "Self-hosted file sync and sharing. Open port 8084 after the first deploy. Set the trusted domains to the names you open it with, or Nextcloud refuses them.",
    "env": [
      {
        "key": "NEXTCLOUD_ADMIN_PASSWORD",
        "description": "Password of the initial admin user (username admin)",
        "secret": true,
        "generate": true
      },
      {
        "key": "NEXTCLOUD_TRUSTED_DOMAINS",
        "description": "Space-separated host names or IPs you open Nextcloud with, e.g. 192.168.1.10 cloud.example.com",
        "secret": false,
        "defaultValue": "localhost"
      }
    ],
    "spec": {
      "services": [
        {
          "name": "nextcloud",
          "image": "nextcloud:29-apache",
          "restart": "unless-stopped",
          "ports": [
            {
              "host": 8084,
              "container": 80,
              "protocol": "tcp"
            }
          ],
          "environment": [
            {
              "key": "NEXTCLOUD_ADMIN_USER",
              "value": "admin"
            },
            {
              "key": "NEXTCLOUD_ADMIN_PASSWORD",
              "ref": "NEXTCLOUD_ADMIN_PASSWORD"
            },
            {
              "key": "NEXTCLOUD_TRUSTED_DOMAINS",
              "ref": "NEXTCLOUD_TRUSTED_DOMAINS"
            }
          ],
          "volumes": [
            {
              "source": "nextcloud-data",
              "target": "/var/www/html",
              "readOnly": false
            }
          ]
        }
      ],
      "volumes": [
        {
          "name": "nextcloud-data",
          "external": false
        }
      ]
    }
  },
  {
    "id": "pihole",
    "name": "Pi-hole",
    "description": "Network-wide ad blocker and DNS server. Open port 8085 and sign in at /admin with the generated password, then point your devices or router at this host as DNS server. Port 53 must be free on the host.",
    "logo": "pihole",
    "env": [
      {
        "key": "WEBPASSWORD",
        "description": "Password of the admin web interface",
        "secret": true,
        "generate": true
      },
      {
        "key": "TZ",
        "description": "Time zone, e.g. Europe/Berlin",
        "secret": false,
        "defaultValue": "UTC"
      }
    ],
    "spec": {
      "services": [
        {
          "name": "pihole",
          "image": "pihole/pihole:2024.07.0",
          "environment": [
            {
              "key": "WEBPASSWORD",
              "ref": "WEBPASSWORD"
            },
            {
              "key": "TZ",
              "ref": "TZ"
            }
          ],
          "ports": [
            {
              "host": 53,
              "container": 53,
              "protocol": "tcp"
            },
            {
              "host": 53,
              "container": 53,
              "protocol": "udp"
            },
            {
              "host": 8085,
              "container": 80,
              "protocol": "tcp"
            }
          ],
          "volumes": [
            {
              "source": "pihole-etc",
              "target": "/etc/pihole",
              "readOnly": false
            },
            {
              "source": "pihole-dnsmasq",
              "target": "/etc/dnsmasq.d",
              "readOnly": false
            }
          ],
          "restart": "unless-stopped"
        }
      ],
      "volumes": [
        {
          "name": "pihole-etc",
          "external": false
        },
        {
          "name": "pihole-dnsmasq",
          "external": false
        }
      ]
    }
  },
  {
    "id": "nginx-proxy-manager",
    "name": "Nginx Proxy Manager",
    "description": "Reverse proxy with a web UI and Let's Encrypt certificates. Open port 8086 after the first deploy and sign in with admin@example.com / changeme, then change both. Proxied traffic arrives on ports 8088 (HTTP) and 8443 (HTTPS).",
    "logo": "nginx-proxy-manager",
    "env": [],
    "spec": {
      "services": [
        {
          "name": "npm",
          "image": "jc21/nginx-proxy-manager:2.11.3",
          "ports": [
            {
              "host": 8088,
              "container": 80,
              "protocol": "tcp"
            },
            {
              "host": 8443,
              "container": 443,
              "protocol": "tcp"
            },
            {
              "host": 8086,
              "container": 81,
              "protocol": "tcp"
            }
          ],
          "volumes": [
            {
              "source": "npm-data",
              "target": "/data",
              "readOnly": false
            },
            {
              "source": "npm-letsencrypt",
              "target": "/etc/letsencrypt",
              "readOnly": false
            }
          ],
          "restart": "unless-stopped"
        }
      ],
      "volumes": [
        {
          "name": "npm-data",
          "external": false
        },
        {
          "name": "npm-letsencrypt",
          "external": false
        }
      ]
    }
  },
